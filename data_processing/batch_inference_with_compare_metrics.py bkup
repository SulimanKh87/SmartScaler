import os
import csv
import sys
import subprocess
from compare_images import load_image, calculate_metrics

input_dir = "output/dataset/256/test/original"
target_dir = "output/dataset/512/test/original"
output_dir = "output/test_output"
model_path = "saved_models/upscaler.h5"
csv_path = os.path.join(output_dir, "batch_compare_metrics.csv")

os.makedirs(output_dir, exist_ok=True)

# Prepare CSV file with headers (overwrite each run)
with open(csv_path, mode="w", newline="") as f:
    writer = csv.writer(f)
    writer.writerow(["Filename", "PSNR", "SSIM", "MSE"])

# Loop through all images
for filename in sorted(os.listdir(input_dir)):
    if not filename.lower().endswith((".png", ".jpg", ".jpeg")):
        continue

    input_path = os.path.join(input_dir, filename)
    output_filename = filename.replace("_256", "_upscaled")
    output_path = os.path.join(output_dir, output_filename)
    target_filename = filename.replace("_256", "_512")
    target_path = os.path.join(target_dir, target_filename)

    print(f"\n🖼️ Processing: {filename}")

    try:
        # 1. Inference
        subprocess.run([
            sys.executable, "data_processing/inference.py",
            "--input", input_path,
            "--output", output_path,
            "--model", model_path
        ], check=True)
        print(f"✅ Inference complete: {filename}")
    except subprocess.CalledProcessError as e:
        print(f"❌ Inference failed for {filename}: {e}")
        continue

    try:
        generated = load_image(output_path)
        ground_truth = load_image(target_path, target_size=generated.shape[:2])
        psnr, ssim, mse = calculate_metrics(generated, ground_truth)

        print("🔍 Comparison Results:")
        print(f"  PSNR : {psnr:.2f} dB")
        print(f"  SSIM : {ssim:.4f}")
        print(f"  MSE  : {mse:.6f}")

        with open(csv_path, mode="a", newline="") as f:
            writer = csv.writer(f)
            writer.writerow([filename, f"{psnr:.2f}", f"{ssim:.4f}", f"{mse:.6f}"])

        print(f"📊 Saved metrics for: {filename}")
    except Exception as e:
        print(f"❌ Comparison failed for {filename}: {e}")
        continue

